generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// 🏥 TENANT (CLÍNICAS)
//////////////////////////////////////////////////////

model Tenant {
  id        String   @id @default(cuid())
  nombre    String
  createdAt DateTime @default(now())

  users     User[]
  pacientes Paciente[]
  turnos    Turno[]
  preparaciones Preparacion[]
}

//////////////////////////////////////////////////////
// 👤 USUARIOS DEL SISTEMA (MEDICO / ADMIN / SECRETARIA)
//////////////////////////////////////////////////////

model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nombre    String
  apellido  String
  email     String   @unique
  password  String
  rol       Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turnos        Turno[]
  historias     HistoriaClinica[]

  @@index([tenantId])
}

//////////////////////////////////////////////////////
// 🧑 PACIENTES
//////////////////////////////////////////////////////

model Paciente {
  id        String   @id @default(cuid())

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nombre    String
  apellido  String
  dni       String

  telefono  String?
  email     String?

  localidad     String?
  obraSocial    String?
  observaciones String?

  username String?
  password String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  archivos  Archivo[]
  historias HistoriaClinica[]
  turnos    Turno[]
  credenciales Credencial[]

  @@unique([tenantId, dni])
  @@index([nombre, apellido])
}

//////////////////////////////////////////////////////
// 📎 ARCHIVOS (ESTUDIOS / INFORMES)
//////////////////////////////////////////////////////

model Archivo {
  id          String   @id @default(cuid())
  pacienteId  String
  paciente    Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  nombre      String
  tipo        FileType
  url         String
  size        Int
  mimeType    String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pacienteId])
  @@index([tipo])
}

//////////////////////////////////////////////////////
// 🩺 HISTORIA CLÍNICA
//////////////////////////////////////////////////////

model HistoriaClinica {
  id          String   @id @default(cuid())

  pacienteId  String
  paciente    Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  medicoId    String
  medico      User     @relation(fields: [medicoId], references: [id])

  motivo         String
  diagnostico    String
  tratamiento    String
  observaciones  String?

  fecha       DateTime @default(now())

  @@index([pacienteId])
  @@index([medicoId])
}

//////////////////////////////////////////////////////
// 📅 TURNOS (CORE DEL SISTEMA)
//////////////////////////////////////////////////////

model Turno {
  id          String   @id @default(cuid())

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  pacienteId  String
  paciente    Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  medicoId    String
  medico      User     @relation(fields: [medicoId], references: [id])

  fecha       DateTime
  estado      TurnoEstado
  ordenLlegada Int?

  notasSecretaria String?
  notasMedico     String?

  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([medicoId, fecha])
  @@index([pacienteId])
}

//////////////////////////////////////////////////////
// 🧾 PREPARACIONES (INDICACIONES PRE-ESTUDIO)
//////////////////////////////////////////////////////

model Preparacion {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nombre    String
  contenido String

  @@index([tenantId])
}

//////////////////////////////////////////////////////
// 🖨️ CREDENCIALES / ETIQUETAS
//////////////////////////////////////////////////////

model Credencial {
  id          String   @id @default(cuid())
  pacienteId  String
  paciente    Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  codigo      String   @unique
  createdAt   DateTime @default(now())

  @@index([pacienteId])
}

//////////////////////////////////////////////////////
// NOMENCLADOR
//////////////////////////////////////////////////////

model Nomenclador {
  id        String @id @default(cuid())
  codigo    String
  practica  String

  @@index([codigo])
}

//////////////////////////////////////////////////////
// 🧠 ENUMS
//////////////////////////////////////////////////////

enum Role {
  ADMIN
  MEDICO
  SECRETARIA
}

enum FileType {
  ESTUDIO
  INFORME
}

enum TurnoEstado {
  PENDIENTE
  CONFIRMADO
  EN_SALA
  ATENDIDO
  CANCELADO
}